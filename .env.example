# ============================================================================
# CASAMENTO ANDREY E AMANDA — Variáveis de Ambiente
# ============================================================================
# Copie este arquivo para .env.local e preencha com seus valores reais.
# NUNCA commite .env.local no repositório.
# ============================================================================

# ----------------------------------------------------------------------------
# Firebase Client SDK (público — prefixo NEXT_PUBLIC_)
# Obtenha em: Firebase Console > Project Settings > General > Your apps
# ----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=sua_api_key_aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# ----------------------------------------------------------------------------
# Firebase Admin SDK (privado — SEM prefixo NEXT_PUBLIC_)
# Opção A (recomendada para Vercel): JSON da Service Account em uma linha
#   - Firebase Console > Project Settings > Service Accounts > Generate new private key
#   - Minifique o JSON e cole como string
# Opção B (desenvolvimento local): caminho para o arquivo JSON
#   - Baixe o JSON e aponte GOOGLE_APPLICATION_CREDENTIALS
# ----------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"..."}
# OU use o caminho do arquivo (apenas desenvolvimento):
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ----------------------------------------------------------------------------
# Segurança da Aplicação
# ----------------------------------------------------------------------------
# Salt para hash de tokens de convite (gere uma string aleatória forte)
TOKEN_SALT=coloque_uma_string_aleatoria_forte_aqui

# ----------------------------------------------------------------------------
# Emulator Suite (desenvolvimento)
# Defina como "true" para conectar ao Firebase Emulator Suite local
# ----------------------------------------------------------------------------
NEXT_PUBLIC_USE_EMULATOR=false

# ----------------------------------------------------------------------------
# ID do Evento (configurado após criação no Firestore)
# Deixe vazio inicialmente; será preenchido após seed ou criação manual
# ----------------------------------------------------------------------------
NEXT_PUBLIC_EVENT_ID=