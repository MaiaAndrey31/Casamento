# ── Credenciais Firebase (NUNCA versionar) ──────────────────────────────────
*firebase-adminsdk*.json
*service-account*.json
*.pem
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ── Variáveis de ambiente ───────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Next.js ─────────────────────────────────────────────────────────────────
.next/
out/

# ── Node.js ─────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build / Dist ────────────────────────────────────────────────────────────
dist/
build/

# ── IDE ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Testes / Coverage ───────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Misc ────────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts